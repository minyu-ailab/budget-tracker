# Optional cloud database sync
# Set to true to enable Supabase sync.
VITE_CLOUD_DB_ENABLED=false

# Supabase project URL, e.g. https://your-project-ref.supabase.co
VITE_SUPABASE_URL=

# Supabase anon key
VITE_SUPABASE_ANON_KEY=

# Bank sync API runtime (server-side only, do not expose in Vite client env)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
